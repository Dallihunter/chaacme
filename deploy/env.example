# chaacme-platform — environment file
#
# Format is KEY=value, one per line. Not a shell script: no `export`, no
# quoting, no $VAR expansion.

# ---------------------------------------------------------------------------
# MANDATORY — the server refuses to start without these
# ---------------------------------------------------------------------------

# Promotes the startup secret checks (and the OTP-delivery check below) from
# warnings to hard failures.
NODE_ENV=production

# Salt for hashing visitor IP addresses used by the rate limiter. Raw IPs are
# never stored. There is no fallback — the server refuses to start without it,
# in every environment. Minimum 16 characters, 32+ recommended.
#   openssl rand -base64 32
IP_HASH_SALT=

# Pepper mixed into every stored OTP code hash. A 5-digit code has only
# 100,000 possibilities, so this is what stops an offline brute force of a
# leaked otp_codes table. No fallback, refuses to start without it.
#   openssl rand -base64 32
OTP_PEPPER=

# The site's own origin, e.g. https://www.example.com  (no trailing slash). It is:
#   - the allowlist for the cross-site request forgery guard: every POST / PUT /
#     PATCH / DELETE to /api/* must carry an Origin (or, failing that, a Referer)
#     that is this origin or its www / non-www twin. Anything else is 403. With
#     it unset the guard falls back to "same host as the request", which DNS
#     rebinding defeats, so the service warns (and refuses to start under
#     NODE_ENV=production);
#   - the one origin allowed to call the API cross-origin with credentials (CORS);
#   - the base of the redirect back to /booking/result after a ZarinPal payment.
# It no longer affects cookies: they are always HttpOnly + Secure, SameSite=Strict
# for the admin session (Path=/api/admin) and SameSite=Lax for the user session.
# (Older releases switched the cookie to SameSite=None when this was set.)
FRONTEND_ORIGIN=


# ---------------------------------------------------------------------------
# Admin login — no env var here
# ---------------------------------------------------------------------------
#
# /api/admin/* (catalog management, review moderation, bookings, user list)
# used to be gated by a single static ADMIN_TOKEN env var. It now requires a
# real username/password login (POST /api/admin/login), and the account
# (username + salted/hashed password) lives in the database, not this file.
#
# Create or reset the (single) admin account on the host with:
#   npm run admin:set-password -- <username> <password>
#
# ---------------------------------------------------------------------------
# OTP delivery — no SMS vendor is wired up yet
# ---------------------------------------------------------------------------
#
# There is no SMS provider integration in this codebase (no vendor was
# chosen / no credentials were supplied). Outside production, verification
# codes are logged to the server console instead of being sent — fine for
# development, but never acceptable for real users' accounts.
#
# In production, the server refuses to start unless SMS_WEBHOOK_URL is set:
# logging a real OTP to stdout/journal would let anyone with log access take
# over any account, so there is no "log it anyway" fallback once
# NODE_ENV=production.
#
# server/auth.js POSTs {"phone": "...", "code": "..."} as JSON to this URL,
# with `Authorization: Bearer SMS_API_KEY` if that's set. Point it at a thin
# adapter in front of whichever vendor you pick (Kavenegar, Twilio, etc.) —
# the exact request/response shape a vendor expects is that adapter's job,
# not this server's.
SMS_WEBHOOK_URL=
SMS_API_KEY=

# ---------------------------------------------------------------------------
# ZarinPal payments
# ---------------------------------------------------------------------------
#
# ZARINPAL_SANDBOX defaults to true (i.e. leaving it unset is safe) — every
# request goes to sandbox.zarinpal.com and no real money moves. Flipping to
# production later is this one flag, not a code change (see server/zarinpal.js).
#
# In sandbox mode, ZARINPAL_MERCHANT_ID can be any UUID-shaped placeholder —
# ZarinPal's sandbox API accepts it. The server will boot without it (only a
# warning), but payment requests will fail until it's set.
#
# Once ZARINPAL_SANDBOX=false, ZARINPAL_MERCHANT_ID must be the real
# merchant id ZarinPal issued you — the server refuses to start otherwise,
# same "fail fast rather than silently misconfigured" policy as SMS_WEBHOOK_URL.
#ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=

# Absolute URL ZarinPal redirects the user's browser back to after payment,
# e.g. https://api.chaacme.ir/api/payments/zarinpal/callback — required in
# production (a payment request has nowhere to send the user back to
# without it).
ZARINPAL_CALLBACK_URL=

# ---------------------------------------------------------------------------
# STRONGLY RECOMMENDED — falls back to a bogus in-repo path otherwise
# ---------------------------------------------------------------------------

# Directory POST /api/admin/upload saves images into (jpg/png/webp, 5MB max).
# Files land under a per-tour subfolder when the request names a valid tourId
# (<dir>/tour-<id>/...), matching the images/tour-<slug>/ convention already
# used for animal-flow/dasbagh, or <dir>/uploads/ otherwise. Must point at the
# frontend's static image tree so the returned path is servable.
#
# Left unset, upload.js falls back to a path derived from the source tree
# (../../images relative to server/), which does not exist in production and
# makes every upload fail with a 500. This is not optional on a real deploy.
#
# Three things all have to line up for uploads to actually work, not just
# this variable:
#   1. This directory must be listed in the systemd unit's ReadWritePaths=
#      (ProtectSystem=strict makes everything else read-only) — see
#      deploy/chaacme-platform.service.
#   2. It must be owned/writable by the service's own user, e.g.:
#        chown -R chaacme-platform:chaacme-platform /srv/chaacme-platform/frontend/images
#   3. Whatever user serves it statically (nginx) needs read access to files
#      this service creates. UMask=0027 in the unit means new files/dirs land
#      0640/0750 — group-readable, not world-readable — so add nginx's user
#      to the chaacme-platform group and reload nginx to pick it up:
#        usermod -aG chaacme-platform www-data && systemctl reload nginx
FRONTEND_STATIC_DIR=/srv/chaacme-platform/frontend/images

# ---------------------------------------------------------------------------
# OPTIONAL — defaults shown; uncomment only to change them
# ---------------------------------------------------------------------------

# Bind address / port.
#HOST=127.0.0.1
#PORT=3100

# SQLite database file. Must live outside the release directory so it
# survives deploys.
#CHAACME_PLATFORM_DB=/srv/chaacme-platform/state/platform.db

# LOCAL DEVELOPMENT ONLY -- leave both unset in production. Cookies are Secure
# unless COOKIE_SECURE=false (needed only for a plain-http dev server that is not
# localhost), and the user cookie is SameSite=Lax unless COOKIE_SAMESITE is
# lax|strict|none. The admin cookie is always SameSite=Strict. The service logs a
# warning for either override and refuses to start with one under NODE_ENV=production.
#COOKIE_SECURE=false
#COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# /tour/<slug> pages (shareable links with per-tour previews)
# ---------------------------------------------------------------------------
#
# Crawlers (Instagram, Telegram, WhatsApp) don't run JS, so a shared tour link
# only previews correctly if the title/Open Graph tags are in the HTML itself.
# Point this at the deployed frontend index.html and this service answers
# GET /tour/<slug> with that file, tags filled in for the tour (404 status and
# the plain shell for an unknown tour). Leave unset to skip this and let nginx
# serve index.html as before. Needs the nginx rule in deploy/nginx-tour.conf.example.
#FRONTEND_INDEX_FILE=/srv/chaacme-platform/frontend/index.html
#
# Public origin used for og:url, canonical and relative cover images.
#SITE_ORIGIN=https://chaacme.ir

# ---------------------------------------------------------------------------
# Pending partner uploads
# ---------------------------------------------------------------------------
#
# Photos a partner uploads wait here for admin review. They must NOT be inside
# FRONTEND_STATIC_DIR (the web root serves everything under it by URL); the
# service refuses to start if they are. Unset, the default is a pending-uploads/
# directory next to the database file, which the service already owns.
#PENDING_UPLOAD_DIR=/path/outside/the/web/root/pending-uploads
