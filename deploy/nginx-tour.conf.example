# Add inside the chaacme.ir server { } block, next to the existing /api proxy.
# Example only: adjust the upstream to match your existing /api location.
#
# /tour/<slug> is rendered by the Node service as full HTML, and the stylesheet,
# fonts and client scripts that page loads live under /assets/ in the release
# (served by the same service). If the service is down, nginx falls back to the
# plain SPA shell, which still renders the tour client-side.

location /tour/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    error_page 502 503 504 = /index.html;
}

location /assets/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_set_header Host $host;
}

# NEEDS A CHECK ON THE SERVER: the two regex locations below use `try_files $uri` against the server's root. If
# /images/ is currently served by a `location /images/ { alias ...; }` block, copy that alias/root and any add_header
# lines (security headers) into these locations; a regex location takes precedence over a prefix location and
# add_header lines are not inherited into a location that has its own add_header.
#
# Image variants sit next to the originals under /images/ (already served from the
# web root). Their names are unique per upload, so they can be cached for good:
location ~* ^/images/.+\.(?:w\d+\.webp|og\.jpg)$ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
}

# Not needed for the pages: the .meta.json files next to the images are internal.
location ~* ^/images/.+\.meta\.json$ { return 404; }

# CDN (ArvanCloud) rules to match:
#   /tour/*                -> cache, honour the origin's Cache-Control (public, max-age=60, stale-while-revalidate=300)
#   /assets/*              -> cache, honour Cache-Control (?v= URLs and /assets/fonts/* are immutable for a year)
#   /images/*.webp, *.og.jpg -> cache for a year (immutable)
#   /api/*                 -> bypass
