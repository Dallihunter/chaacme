# Add inside the chaacme.ir server { } block, next to the existing /api proxy.
# Example only: adjust the upstream to match your existing /api location.
#
# /tour/<slug> goes to the Node service (which needs FRONTEND_INDEX_FILE set)
# so shared links carry per-tour previews. If the service is down, nginx falls
# back to the plain SPA shell, which still renders the tour client-side.

location /tour/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    error_page 502 503 504 = /index.html;
}
